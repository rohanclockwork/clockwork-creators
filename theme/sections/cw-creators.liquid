{%- comment -%}
  CLOCKWORK CREATORS — the public programme page and sign-up (/pages/creators).
  Data and decisions come from the creator service (section setting "Service address").
  States: landing · details form (?step=details&s=…) · results (?result=…) · check your email.
{%- endcomment -%}

{%- assign api = section.settings.api_url | default: 'https://creators.clockworkrituals.com' -%}
{%- assign mark_img = section.settings.brand_mark -%}

<style>
  .cc-page { --cc-black:#0a0a0a; --cc-near:#111; --cc-char:#1a1a1a; --cc-dark:#222; --cc-mid:#6b6b6b; --cc-light:#9a9a9a; --cc-off:#ddd; --cc-white:#fff; --cc-mint:#8ACDB2;
    font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; color:var(--cc-off); background:var(--cc-black); -webkit-font-smoothing:antialiased; line-height:1.55; }
  .cc-page *{ box-sizing:border-box; }
  .cc-hero{ text-align:center; padding:84px 24px 64px; position:relative; overflow:hidden; }
  .cc-hero::before{ content:''; position:absolute; inset:0; pointer-events:none; background:radial-gradient(ellipse 70% 50% at 50% 40%, rgba(138,205,178,0.06) 0%, transparent 70%); }
  .cc-kicker{ font-size:11px; letter-spacing:.35em; text-transform:uppercase; color:var(--cc-light); margin:0 0 18px; }
  .cc-title{ font-size:clamp(36px,7vw,64px); font-weight:200; letter-spacing:.12em; text-transform:uppercase; color:var(--cc-white); line-height:1.1; margin:0 0 20px; }
  .cc-sub{ font-size:15px; color:var(--cc-light); max-width:520px; margin:0 auto; line-height:1.7; }
  .cc-btn{ display:inline-block; margin-top:32px; padding:14px 44px; background:var(--cc-white); color:var(--cc-black)!important; text-decoration:none; font-size:11px; font-weight:600; letter-spacing:.2em; text-transform:uppercase; border:0; cursor:pointer; transition:opacity .2s; }
  .cc-btn:hover{ opacity:.85; } .cc-btn[disabled]{ opacity:.5; cursor:wait; }
  .cc-link{ color:var(--cc-off); text-decoration:underline; text-underline-offset:3px; }
  .cc-note{ font-size:12px; color:var(--cc-mid); margin-top:14px; }
  .cc-band{ background:var(--cc-near); }
  .cc-section{ padding:64px 24px; max-width:920px; margin:0 auto; }
  .cc-divider{ width:36px; height:1px; background:rgba(255,255,255,.12); margin:0 auto 16px; }
  .cc-h{ text-align:center; font-size:10px; font-weight:600; letter-spacing:.3em; text-transform:uppercase; color:var(--cc-light); margin:0 0 40px; }
  .cc-earn{ display:grid; grid-template-columns:1.2fr 1fr; gap:0; max-width:820px; margin:0 auto; }
  .cc-card{ border:1px solid rgba(255,255,255,.07); padding:40px 28px; text-align:center; }
  .cc-card + .cc-card{ border-left:none; }
  .cc-card.is-main{ background:var(--cc-char); border-color:rgba(255,255,255,.12); }
  .cc-card-label{ font-size:10px; font-weight:600; letter-spacing:.25em; text-transform:uppercase; color:var(--cc-light); margin-bottom:14px; }
  .cc-card-num{ font-size:52px; font-weight:200; color:var(--cc-white); line-height:1; margin-bottom:8px; }
  .cc-card-text{ font-size:13px; color:var(--cc-light); max-width:300px; margin:0 auto; }
  .cc-tiers{ display:flex; justify-content:center; gap:28px; margin-top:16px; font-size:12px; color:var(--cc-light); }
  .cc-tiers b{ display:block; font-size:22px; font-weight:200; color:var(--cc-white); }
  .cc-steps{ display:grid; grid-template-columns:repeat(3,1fr); gap:40px; max-width:780px; margin:0 auto; text-align:center; }
  .cc-step-num{ font-size:32px; font-weight:200; color:var(--cc-mid); margin-bottom:12px; }
  .cc-step h3{ font-size:11px; font-weight:600; letter-spacing:.2em; text-transform:uppercase; color:var(--cc-off); margin:0 0 8px; }
  .cc-step p{ font-size:13px; color:var(--cc-light); margin:0; }
  .cc-list{ max-width:620px; margin:0 auto; }
  .cc-row{ display:flex; justify-content:space-between; gap:24px; padding:15px 0; border-bottom:1px solid rgba(255,255,255,.06); font-size:13px; }
  .cc-row span:first-child{ color:var(--cc-light); } .cc-row span:last-child{ color:var(--cc-white); text-align:right; }
  .cc-faq{ max-width:680px; margin:0 auto; }
  .cc-faq details{ border-bottom:1px solid rgba(255,255,255,.06); padding:16px 0; }
  .cc-faq summary{ cursor:pointer; font-size:14px; color:var(--cc-white); list-style:none; }
  .cc-faq summary::-webkit-details-marker{ display:none; }
  .cc-faq summary::after{ content:'+'; float:right; color:var(--cc-mid); }
  .cc-faq details[open] summary::after{ content:'\2212'; }
  .cc-faq p{ font-size:13px; color:var(--cc-light); margin:10px 0 0; }
  .cc-panel{ max-width:560px; margin:0 auto; padding:56px 24px 72px; }
  .cc-panel h2{ font-size:clamp(24px,4vw,34px); font-weight:200; letter-spacing:.08em; text-transform:uppercase; color:var(--cc-white); text-align:center; margin:0 0 12px; }
  .cc-panel > p{ text-align:center; color:var(--cc-light); font-size:14px; }
  .cc-form label{ display:block; font-size:10px; font-weight:600; letter-spacing:.2em; text-transform:uppercase; color:var(--cc-light); margin:22px 0 8px; }
  .cc-form input[type=text], .cc-form input[type=email], .cc-form input[type=tel], .cc-form select{ width:100%; padding:13px 14px; background:var(--cc-near); border:1px solid rgba(255,255,255,.12); color:var(--cc-white); font-size:15px; border-radius:0; font-family:inherit; }
  .cc-form input:focus, .cc-form select:focus{ outline:none; border-color:var(--cc-mint); }
  .cc-form .cc-hint{ font-size:12px; color:var(--cc-mid); margin-top:6px; }
  .cc-form .cc-check{ display:flex; gap:10px; align-items:flex-start; font-size:13px; letter-spacing:0; text-transform:none; font-weight:400; color:var(--cc-off); }
  .cc-form .cc-check input{ margin-top:3px; accent-color:var(--cc-mint); }
  .cc-form fieldset{ border:0; padding:0; margin:36px 0 0; }
  .cc-form legend{ font-size:11px; font-weight:600; letter-spacing:.25em; text-transform:uppercase; color:var(--cc-white); padding:0; }
  .cc-msg{ border:1px solid rgba(255,255,255,.1); padding:16px 18px; font-size:13px; margin:20px 0; }
  .cc-msg.is-error{ border-color:#c0574b; color:#f2c4be; }
  .cc-msg ul{ margin:8px 0 0 18px; padding:0; }
  .cc-hp{ position:absolute; left:-9999px; }
  .cc-hide{ display:none!important; }
  .cc-foot{ text-align:center; padding:44px 24px; border-top:1px solid rgba(255,255,255,.05); font-size:11px; color:var(--cc-mid); }
  .cc-foot img{ width:28px; height:28px; opacity:.15; margin-bottom:12px; object-fit:contain; }
  @media (max-width:720px){
    .cc-earn{ grid-template-columns:1fr; } .cc-card + .cc-card{ border-left:1px solid rgba(255,255,255,.07); border-top:none; }
    .cc-steps{ grid-template-columns:1fr; gap:32px; } .cc-hero{ padding:64px 20px 48px; }
  }
</style>

<div class="cc-page" id="cc-page" data-api="{{ api | escape }}">

  {%- comment -%} ══════ LANDING ══════ {%- endcomment -%}
  <div id="cc-landing">
    <div class="cc-hero">
      <p class="cc-kicker">{{ section.settings.kicker }}</p>
      <h1 class="cc-title">{{ section.settings.title }}</h1>
      <p class="cc-sub">{{ section.settings.intro }}</p>
      <div id="cc-result" class="cc-msg cc-hide" style="max-width:520px;margin:28px auto 0;text-align:left;"></div>
      <a class="cc-btn" href="{{ api }}/join">{{ section.settings.cta }}</a>
      <p class="cc-note">Already a creator? <a class="cc-link" href="/pages/creator-dashboard">Sign in to your dashboard</a></p>
    </div>

    <div class="cc-band"><div class="cc-section">
      <div class="cc-divider"></div><p class="cc-h">What you earn</p>
      <div class="cc-earn">
        <div class="cc-card is-main">
          <div class="cc-card-label">Every new customer</div>
          <div class="cc-card-num">₹300</div>
          <p class="cc-card-text">{{ section.settings.flat_text }}</p>
        </div>
        <div class="cc-card">
          <div class="cc-card-label">Every repeat order</div>
          <div class="cc-tiers"><span><b>10%</b>Starter</span><span><b>15%</b>Pro</span><span><b>20%</b>Elite</span></div>
          <p class="cc-card-text" style="margin-top:16px;">Pro from 25 orders a month, Elite from 100.</p>
        </div>
      </div>
      <p class="cc-note" style="text-align:center;margin-top:20px;">Your audience gets 10% off with your code, once each.</p>
    </div></div>

    <div class="cc-section">
      <div class="cc-divider"></div><p class="cc-h">How it works</p>
      <div class="cc-steps">
        <div class="cc-step"><div class="cc-step-num">01</div><h3>Connect</h3><p>Connect your Instagram professional account. We check your followers, reach and audience automatically, in seconds.</p></div>
        <div class="cc-step"><div class="cc-step-num">02</div><h3>Share</h3><p>Get your own code and link. Post honestly about your ritual, and disclose the partnership in every post.</p></div>
        <div class="cc-step"><div class="cc-step-num">03</div><h3>Get paid</h3><p>Orders count once delivered and past the 7-day window. During the launch we pay every Monday, by UPI or bank transfer.</p></div>
      </div>
    </div>

    <div class="cc-band"><div class="cc-section">
      <div class="cc-divider"></div><p class="cc-h">Who can join</p>
      <div class="cc-list">
        <div class="cc-row"><span>Instagram</span><span>A professional (creator or business) account</span></div>
        <div class="cc-row"><span>Followers</span><span>3,000 or more, most of them in India</span></div>
        <div class="cc-row"><span>Reach</span><span>Real views on your recent reels</span></div>
        <div class="cc-row"><span>Age and tax</span><span>18 or over, with a PAN</span></div>
        <div class="cc-row"><span>Not eligible</span><span>Coupon, deals and cashback accounts</span></div>
      </div>
    </div></div>

    <div class="cc-section">
      <div class="cc-divider"></div><p class="cc-h">Questions</p>
      <div class="cc-faq">
        <details><summary>What does Clockwork read from my Instagram?</summary><p>Your profile, follower count, recent reels and their views, and summary audience insights such as the countries your followers are in. We never post, comment or send messages. You can disconnect Clockwork Creators in Instagram at any time.</p></details>
        <details><summary>What counts as a new customer?</summary><p>Someone placing their first ever Clockwork order, through your code or link. Each customer can earn a ₹300 payment once.</p></details>
        <details><summary>When do I get paid?</summary><p>An order counts 7 days after delivery. During the launch we pay every Monday for the previous week. Balances under ₹500 carry forward. Tax is deducted at source as the law requires, and every payment comes with a statement.</p></details>
        <details><summary>What can I say about the product?</summary><p>Your honest experience, and the facts on our packs: Clockwork Daily contains 10% nanoXIM·CarePaste, made by FLUIDINOVA, and helps remineralise enamel. The full do and don't list is in the Creator Terms and your welcome email.</p></details>
        <details><summary>How long does the ₹300 offer run?</summary><p>For orders placed until 30 June 2027. After that, every order earns your tier percentage.</p></details>
      </div>
      <p class="cc-note" style="text-align:center;margin-top:28px;">By joining you agree to the <a class="cc-link" href="/pages/creator-terms">Creator Terms</a>. Questions: <a class="cc-link" href="mailto:partners@clockworkrituals.com">partners@clockworkrituals.com</a></p>
      <p style="text-align:center;"><a class="cc-btn" href="{{ api }}/join">{{ section.settings.cta }}</a></p>
    </div>
  </div>

  {%- comment -%} ══════ DETAILS FORM ══════ {%- endcomment -%}
  <div id="cc-details" class="cc-panel cc-hide">
    <p class="cc-kicker" style="text-align:center;">Clockwork Creators</p>
    <h2>Nearly there</h2>
    <p id="cc-details-intro">Your Instagram account qualifies. Add your details so we can set up your code and pay you.</p>
    <div id="cc-errors" class="cc-msg is-error cc-hide"></div>
    <form class="cc-form" id="cc-form" novalidate>
      <input class="cc-hp" type="text" name="website" tabindex="-1" autocomplete="off">
      <label for="cc-name">Full name</label><input id="cc-name" type="text" name="name" autocomplete="name" required>
      <label for="cc-email">Email</label><input id="cc-email" type="email" name="email" autocomplete="email" required>
      <div class="cc-hint">We send your code, statements and sign-in links here.</div>
      <label for="cc-mobile">Mobile</label><input id="cc-mobile" type="tel" name="mobile" autocomplete="tel" required>
      <label for="cc-code">Preferred code (optional)</label><input id="cc-code" type="text" name="preferred_code" maxlength="15">
      <div class="cc-hint">4 to 15 letters or numbers. If it is taken, we make one from your handle.</div>

      <fieldset><legend>Payout and tax</legend>
        <div class="cc-hint" style="margin-top:8px;">Needed to pay you and deduct tax at source as the law requires. Stored encrypted; only the last four characters are ever shown.</div>
        <label for="cc-pan">PAN</label><input id="cc-pan" type="text" name="pan" maxlength="10" autocapitalize="characters" required>
        <label for="cc-panname">Name exactly as on PAN</label><input id="cc-panname" type="text" name="pan_name" required>
        <label for="cc-method">Payout method</label>
        <select id="cc-method" name="payout_method"><option value="upi">UPI</option><option value="bank">Bank account</option></select>
        <div id="cc-upi"><label for="cc-vpa">UPI ID</label><input id="cc-vpa" type="text" name="vpa" placeholder="name@okhdfcbank"></div>
        <div id="cc-bank" class="cc-hide">
          <label for="cc-acct">Bank account number</label><input id="cc-acct" type="text" name="account" inputmode="numeric">
          <label for="cc-ifsc">IFSC</label><input id="cc-ifsc" type="text" name="ifsc" autocapitalize="characters">
        </div>
      </fieldset>

      <fieldset id="cc-kit" class="cc-hide"><legend>Where should we send your tube</legend>
        <div class="cc-hint" style="margin-top:8px;">Your reach puts you in our Spotlight group, so we send you a tube of Clockwork Daily.</div>
        <label for="cc-a1">Address line 1</label><input id="cc-a1" type="text" name="address1" autocomplete="address-line1">
        <label for="cc-a2">Address line 2</label><input id="cc-a2" type="text" name="address2" autocomplete="address-line2">
        <label for="cc-city">City</label><input id="cc-city" type="text" name="city" autocomplete="address-level2">
        <label for="cc-state">State</label><input id="cc-state" type="text" name="province" autocomplete="address-level1">
        <label for="cc-zip">PIN code</label><input id="cc-zip" type="text" name="zip" inputmode="numeric" maxlength="6" autocomplete="postal-code">
      </fieldset>

      <label class="cc-check" style="margin-top:32px;"><input type="checkbox" name="terms" required> <span>I agree to the <a class="cc-link" href="/pages/creator-terms" target="_blank">Creator Terms</a></span></label>
      <label class="cc-check" style="margin-top:12px;"><input type="checkbox" name="marketing"> <span>Send me Clockwork product news (optional)</span></label>
      <p style="text-align:center;"><button class="cc-btn" type="submit" id="cc-submit">Continue</button></p>
    </form>
  </div>

  {%- comment -%} ══════ CHECK YOUR EMAIL ══════ {%- endcomment -%}
  <div id="cc-sent" class="cc-panel cc-hide">
    <p class="cc-kicker" style="text-align:center;">Clockwork Creators</p>
    <h2>Check your email</h2>
    <p>We have sent a link to <strong id="cc-sent-email" style="color:#fff;"></strong>. Open it to confirm your address, and your code will be ready.</p>
  </div>

  <div class="cc-foot">
    {% if mark_img != blank %}<img src="{{ mark_img | image_url: width: 56 }}" alt="" loading="lazy"><br>{% endif %}
    Clockwork Creators is Clockwork Rituals' creator programme.
  </div>
</div>

<script>
(function(){
  var root = document.getElementById('cc-page');
  var API = root.getAttribute('data-api');
  var qs = new URLSearchParams(location.search);
  var $ = function(id){ return document.getElementById(id); };
  var show = function(id){ ['cc-landing','cc-details','cc-sent'].forEach(function(x){ $(x).classList.toggle('cc-hide', x !== id); }); window.scrollTo(0, 0); };
  var esc = function(s){ var d = document.createElement('div'); d.textContent = s == null ? '' : String(s); return d.innerHTML; };

  var REASONS = {
    followers: 'Fewer than 3,000 followers',
    india_audience: 'Most of your audience is not in India',
    activity: 'Not enough recent reels',
    reach: 'Recent reels reach too few people for your follower count',
    follower_spike: 'A sudden jump in followers in the last 30 days',
    deals_account: 'Deals, coupon and cashback accounts are not eligible'
  };
  var result = qs.get('result');
  if (result) {
    var box = $('cc-result'), html = '';
    if (result === 'not_qualified') {
      var rs = (qs.get('reasons') || '').split(',').filter(Boolean).map(function(r){ return '<li>' + esc(REASONS[r] || r) + '</li>'; }).join('');
      html = '<strong style="color:#fff">Your account does not qualify yet.</strong><ul>' + rs + '</ul><p style="margin:10px 0 0">You can apply again from ' + esc(qs.get('after')) + '.</p>';
    } else if (result === 'wait') html = 'You can apply again from ' + esc(qs.get('after')) + '.';
    else if (result === 'not_eligible') html = 'This account cannot join the programme. Write to partners@clockworkrituals.com if you think this is a mistake.';
    else if (result === 'cancelled') html = 'Instagram was not connected. You can try again whenever you are ready.';
    else if (result === 'link_expired') html = 'That link has expired. Connect Instagram again to get a new one.';
    else html = 'That took too long. Please connect Instagram again.';
    box.innerHTML = html; box.classList.remove('cc-hide');
  }

  var s = qs.get('s');
  if (qs.get('step') === 'details' && s) {
    fetch(API + '/api/signup?s=' + encodeURIComponent(s)).then(function(r){ return r.json().then(function(d){ return { ok: r.ok, d: d }; }); }).then(function(x){
      if (!x.ok) { location.replace(location.pathname + '?result=expired'); return; }
      $('cc-details-intro').textContent = 'Your Instagram account @' + x.d.username + ' qualifies. Add your details so we can set up your code and pay you.';
      if (x.d.spotlight) $('cc-kit').classList.remove('cc-hide');
      show('cc-details');
    }).catch(function(){ location.replace(location.pathname + '?result=expired'); });
  }

  $('cc-method').addEventListener('change', function(e){
    var bank = e.target.value === 'bank';
    $('cc-bank').classList.toggle('cc-hide', !bank); $('cc-upi').classList.toggle('cc-hide', bank);
  });

  $('cc-form').addEventListener('submit', function(e){
    e.preventDefault();
    var f = e.target, btn = $('cc-submit'), errs = $('cc-errors');
    var body = { s: s };
    Array.prototype.forEach.call(f.elements, function(el){ if (!el.name) return; body[el.name] = el.type === 'checkbox' ? el.checked : el.value; });
    btn.disabled = true; errs.classList.add('cc-hide');
    fetch(API + '/api/signup', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
      .then(function(r){ return r.json().then(function(d){ return { status: r.status, d: d }; }); })
      .then(function(x){
        btn.disabled = false;
        if (x.status === 200 && x.d.ok) { $('cc-sent-email').textContent = x.d.email; history.replaceState(null, '', location.pathname); show('cc-sent'); return; }
        if (x.status === 401) { location.replace(location.pathname + '?result=expired'); return; }
        var list = x.d.errors || [x.d.message || 'Something went wrong. Please try again.'];
        errs.innerHTML = list.map(function(m){ return esc(m); }).join('<br>');
        errs.classList.remove('cc-hide'); errs.scrollIntoView({ behavior: 'smooth', block: 'center' });
        if (x.d.rejected) f.classList.add('cc-hide');
      })
      .catch(function(){ btn.disabled = false; errs.textContent = 'We could not reach our server. Please try again in a minute.'; errs.classList.remove('cc-hide'); });
  });
})();
</script>

{% schema %}
{
  "name": "Clockwork Creators",
  "tag": "section",
  "class": "cw-creators-section",
  "settings": [
    { "type": "text", "id": "api_url", "label": "Service address", "default": "https://creators.clockworkrituals.com", "info": "The creator service. Change only if it moves." },
    { "type": "image_picker", "id": "brand_mark", "label": "Brand mark (footer)" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Creator programme" },
    { "type": "text", "id": "title", "label": "Title", "default": "Clockwork Creators" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Share the toothpaste you actually use. Every new customer who orders through your code or link earns you ₹300, and your audience gets 10% off." },
    { "type": "text", "id": "cta", "label": "Button text", "default": "Connect Instagram" },
    { "type": "textarea", "id": "flat_text", "label": "₹300 card text", "default": "For each customer's first Clockwork order through your code or link, until 30 June 2027." }
  ],
  "presets": [{ "name": "Clockwork Creators" }]
}
{% endschema %}
